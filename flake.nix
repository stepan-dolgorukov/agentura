{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs =
    { nixpkgs, ... }:
    let
      pkgs = import nixpkgs {
        system = "x86_64-linux";
        config.allowUnfree = true;
      };
    in
    {
      devShells.x86_64-linux.default = pkgs.mkShellNoCC {
        packages = map (agent: pkgs.callPackage agent { }) [
          ./claude.nix
          ./grok.nix
        ];
      };
    };
}
